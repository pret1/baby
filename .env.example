# Строки подключения к Neon Postgres. `neon link` / `neon deploy` записывают их
# в .env.local сами. Вручную: Neon Console → проект → Connect.
# Скопируйте этот файл в .env.local и подставьте свои значения.

# Pooled (хост с -pooler) — для приложения.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Прямое подключение (без -pooler) — для миграций drizzle-kit.
# Если не задано, миграции идут через DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
